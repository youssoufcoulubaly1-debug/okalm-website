/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/beta
  X-Robots-Tag: noindex, nofollow

/beta.html
  X-Robots-Tag: noindex, nofollow

# Pages de téléchargement des applications Android
# Jamais mises en cache : le lien APK et la version doivent rester frais
/get-app-okalm/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/get-app-kalmeurs/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/telecharger-au-calme.html
  Cache-Control: no-cache, no-store, must-revalidate
/telecharger-kalmeurs.html
  Cache-Control: no-cache, no-store, must-revalidate

# Feuille de style partagée des deux pages de téléchargement
/downloads.css
  Cache-Control: public, max-age=86400

# Logos et icônes des applications
/assets/*
  Cache-Control: public, max-age=2592000

# Fichiers APK téléchargeables
# Nom de fichier versionné : une nouvelle version = un nouveau fichier,
# donc cache long sans risque de servir une version périmée.
/apk/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment
